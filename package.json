{
	"name": "pokemon5e-foundry-module",
	"version": "0.13.0",
	"description": "(BETA VERSION) Everything you need to play Pokémon 5e: Pokémon Bestiary, Items, Moves, Types, Trainer Class, and more!",
	"type": "module",
	"private": true,
	"license": "MIT",
	"author": "Missing Glitch",
	"packageManager": "pnpm@12.11.2",
	"devDependencies": {
		"@foundryvtt/foundryvtt-cli": "^3.0.4",
		"eslint": "^10.12.0",
		"@eslint/js": "^10.0.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-prettier": "^5.5.6",
		"prettier": "^3.9.9",
		"vitest": "^5.0.5",
		"@vitest/ui": "^5.0.5",
		"@vitest/coverage-istanbul": "^5.0.5",
		"@vitest/browser-playwright": "^5.0.5",
		"happy-dom": "^20.14.6",
		"playwright": "^1.64.0",
		"@playwright/test": "^1.64.0"
	},
	"devEngines": {
		"runtime": {
			"name": "node",
			"version": ">=24.14.0 <25",
			"onFail": "error"
		},
		"packageManager": {
			"name": "pnpm",
			"version": "12.11.2",
			"onFail": "error"
		}
	},
	"scripts": {
		"format": "prettier --check . --config .devconfig/prettier.config.js",
		"format:fix": "prettier --write . --config .devconfig/prettier.config.js",
		"lint": "eslint . --config .devconfig/eslint.config.js",
		"lint:fix": "eslint --fix . --config .devconfig/eslint.config.js",
		"test": "vitest --config .devconfig/vitest.config.js",
		"test:all": "vitest run --config .devconfig/vitest.config.js",
		"test:unit": "vitest run --project unit --config .devconfig/vitest.config.js",
		"test:dom": "vitest run --project dom --config .devconfig/vitest.config.js",
		"test:browser": "vitest run --project browser --config .devconfig/vitest.config.js",
		"test:coverage": "vitest run --coverage --config .devconfig/vitest.config.js",
		"test:view-report": "vite preview --outDir test-reports/vitest/reports --open",
		"test:coverage:view-report": "vite preview --outDir test-reports/vitest/coverages --open",
		"test:e2e": "playwright test --config .devconfig/playwright.config.js",
		"test:e2e:ui": "playwright test --ui --config .devconfig/playwright.config.js",
		"test:e2e:headed": "playwright test --headed --config .devconfig/playwright.config.js",
		"test:e2e:report": "playwright show-report test-reports/playwright/reports/",
		"check:package": "node tools/check-package.mjs",
		"check:manifest": "node tools/check-manifest.mjs",
		"build:packs": "node tools/build-packs.mjs",
		"build": "pnpm run build:packs && pnpm run check:manifest",
		"ci": "pnpm run format && pnpm run lint && pnpm run test:unit && pnpm run build"
	}
}
